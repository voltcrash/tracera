# Copy this file to .env and fill in real values. Never commit .env itself.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tracera
DB_USER=postgres
DB_PASSWORD=change_me

# --- GDELT ---
# GDELT's DOC 2.0 API is free and keyless, so no API key is required.
# This is kept here so a future paid/rate-limited tier can be swapped in
# without touching code.
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc

# --- Ingestion behavior ---
# Max articles to pull per RSS source per run
RSS_MAX_ARTICLES_PER_SOURCE=50
# Max articles to pull from GDELT per query per run
GDELT_MAX_ARTICLES_PER_QUERY=50
# Request timeout (seconds) for any outbound HTTP call
HTTP_TIMEOUT_SECONDS=15

# --- Storage paths ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
