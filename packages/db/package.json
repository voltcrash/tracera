{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./test-runtime": "./test/d1/runtime.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply tracera-staging --local --config ../../apps/web/wrangler.jsonc --persist-to ../../apps/web/.wrangler/state",
    "test:d1": "vp test --run test/d1",
    "db:generate:auth": "auth generate --config auth-schema.config.ts --adapter drizzle --dialect sqlite --output ../../tmp/auth-schema.sqlite.ts --yes"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.0",
    "auth": "^1.7.7",
    "better-auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "^4.150.0"
  }
}
