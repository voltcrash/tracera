{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./analysis": "./src/analysis/index.ts",
    "./analysis/repository": "./src/analysis/repository.ts",
    "./analysis/schema": "./src/analysis/schema.ts",
    "./schema": "./src/schema.ts",
    "./d1/schema": "./src/d1/schema.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "node ../../scripts/environment/guard.mjs --role migration -- drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node ../../scripts/environment/guard.mjs --role migration -- drizzle-kit migrate --config=drizzle.config.ts",
    "test:analysis-storage": "node ../../scripts/database/test-analysis-storage.mjs",
    "db:generate:d1": "drizzle-kit generate --config=drizzle.d1.config.ts --name baseline"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@repo/contracts": "workspace:*",
    "@repo/environment": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.7",
    "better-auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "^4.149.0"
  }
}
