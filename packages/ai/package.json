{
  "name": "@repo/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./core/adjudication": "./src/core/adjudication/index.ts",
    "./core/claims": "./src/core/claims/index.ts",
    "./core/evidence": "./src/core/evidence/index.ts",
    "./core/framing": "./src/core/framing/index.ts",
    "./core/ingestion": "./src/core/ingestion/index.ts",
    "./core/hashing": "./src/core/hashing.ts",
    "./core/provenance": "./src/core/provenance/index.ts",
    "./core/publication": "./src/core/publication/index.ts",
    "./core/report-view": "./src/core/report-view.ts",
    "./core/retrieval": "./src/core/retrieval/index.ts",
    "./core/selection": "./src/core/selection/index.ts",
    "./core/scoring": "./src/core/scoring/index.ts",
    "./core/timeline": "./src/core/timeline.ts",
    "./core/types": "./src/core/types.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "evaluate:core-release": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-release.ts",
    "evaluate:core-adjudication": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-adjudication.ts",
    "evaluate:core-claims": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-claims.ts",
    "evaluate:core-evidence": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-evidence.ts",
    "evaluate:core-focused": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-focused.ts",
    "evaluate:core-provenance": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-provenance.ts",
    "evaluate:core-retrieval": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-core-retrieval.ts",
    "test:core-adjudication": "vp test --run test/core-adjudication.test.ts",
    "test:core-claims": "vp test --run test/core-claims.test.ts",
    "test:core-evidence": "vp test --run test/core-evidence.test.ts",
    "test:core-ingestion": "vp test --run test/core-ingestion.test.ts",
    "test:core-provenance": "vp test --run test/core-provenance.test.ts",
    "test:core-retrieval": "vp test --run test/core-retrieval.test.ts",
    "test:core-scoring": "vp test --run test/core-scoring.test.ts",
    "test:core-orchestration": "vp test --run test/core-orchestration.test.ts",
    "test:core-publication": "vp test --run test/core-publication.test.ts",
    "test:core-release": "vp test --run test/core-release-evaluation.test.ts",
    "test:live": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/live-test.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "cheerio": "^1.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
