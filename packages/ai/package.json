{
  "name": "@repo/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis/index.ts",
    "./analysis/adjudication": "./src/analysis/adjudication/index.ts",
    "./analysis/claims": "./src/analysis/claims/index.ts",
    "./analysis/evidence": "./src/analysis/evidence/index.ts",
    "./analysis/framing": "./src/analysis/framing/index.ts",
    "./analysis/ingestion": "./src/analysis/ingestion/index.ts",
    "./analysis/hashing": "./src/analysis/hashing.ts",
    "./analysis/provenance": "./src/analysis/provenance/index.ts",
    "./analysis/publication": "./src/analysis/publication/index.ts",
    "./analysis/report-view": "./src/analysis/report-view.ts",
    "./analysis/retrieval": "./src/analysis/retrieval/index.ts",
    "./analysis/selection": "./src/analysis/selection/index.ts",
    "./analysis/scoring": "./src/analysis/scoring/index.ts",
    "./analysis/timeline": "./src/analysis/timeline.ts",
    "./analysis/types": "./src/analysis/types.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "evaluate:analysis-release": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-release.ts",
    "evaluate:analysis-adjudication": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-adjudication.ts",
    "evaluate:analysis-claims": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-claims.ts",
    "evaluate:analysis-evidence": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-evidence.ts",
    "evaluate:analysis-focused": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-focused.ts",
    "evaluate:analysis-provenance": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-provenance.ts",
    "evaluate:analysis-retrieval": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/evaluate-analysis-retrieval.ts",
    "test:analysis-adjudication": "vp test --run test/analysis-adjudication.test.ts",
    "test:analysis-claims": "vp test --run test/analysis-claims.test.ts",
    "test:analysis-evidence": "vp test --run test/analysis-evidence.test.ts",
    "test:analysis-ingestion": "vp test --run test/analysis-ingestion.test.ts",
    "test:analysis-provenance": "vp test --run test/analysis-provenance.test.ts",
    "test:analysis-retrieval": "vp test --run test/analysis-retrieval.test.ts",
    "test:analysis-orchestration": "vp test --run test/analysis-orchestration.test.ts",
    "test:analysis-publication": "vp test --run test/analysis-publication.test.ts",
    "test:analysis-release": "vp test --run test/analysis-release-evaluation.test.ts",
    "test:live": "node ../../scripts/environment/guard.mjs --role analysis -- node --import tsx scripts/live-test.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "cheerio": "^1.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
