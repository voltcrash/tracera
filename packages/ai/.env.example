# Free local option (requires Ollama plus pulled models)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b
# The database vectors are 1024-dimensional.
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Free-tier-capable hosted option (Google AI Studio key required)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_FACT_CHECK_API_KEY=
