# Used by the @repo/ai live-test and model-validation scripts.
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-provider-api-key

# Optional provider-specific overrides. Gemini has suitable defaults.
# AI_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_PROVIDER=openai         # Required when using Anthropic.
# AI_EMBEDDING_API_KEY=
# AI_BASE_URL=                         # Required for openai-compatible.
# AI_EMBEDDING_BASE_URL=

# Required only by the pipeline live test.
# GOOGLE_FACT_CHECK_API_KEY=
