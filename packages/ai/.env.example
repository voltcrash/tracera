# Provider-neutral AI configuration. Supported: gemini, openai, openrouter,
# anthropic, and openai-compatible.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# The database vectors are 1024-dimensional.
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
# AI_BASE_URL=
# For Anthropic generation, configure embeddings separately:
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-3-small
# GOOGLE_FACT_CHECK_API_KEY=
