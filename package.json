{
  "name": "tracera",
  "private": true,
  "scripts": {
    "dev": "vp run web#dev",
    "dev:live": "vp run web#dev:live",
    "db:generate": "vp run @repo/db#db:generate",
    "db:migrate": "vp run web#db:migrate",
    "db:reset": "vp run web#db:reset",
    "cf-typegen": "vp run web#cf-typegen",
    "build": "vp run web#build",
    "preview": "vp run web#preview",
    "deploy:staging": "vp run web#deploy:staging",
    "check:production": "vp run web#check:production",
    "deploy:production-dry-run": "vp run web#deploy:production-dry-run",
    "db:migrate:production": "vp run web#db:migrate:production",
    "deploy:production": "vp run web#deploy:production",
    "check-types": "vp run -r check-types",
    "test:auth-browser": "vp run web#test:auth-browser",
    "evaluate:analysis-release:fixture": "vp run @repo/ai#evaluate:analysis-release --mode fixture --split all --seed 20260910",
    "evaluate:analysis-adjudication:fixture": "vp run @repo/ai#evaluate:analysis-adjudication --mode fixture --split all --seed 20260910",
    "evaluate:analysis-claims:fixture": "vp run @repo/ai#evaluate:analysis-claims --mode fixture --split all --seed 20260910",
    "evaluate:analysis-evidence:fixture": "vp run @repo/ai#evaluate:analysis-evidence --mode fixture --split all --seed 20260910",
    "evaluate:analysis-focused:fixture": "vp run @repo/ai#evaluate:analysis-focused --mode fixture --split all --seed 20260910",
    "evaluate:analysis-provenance:fixture": "vp run @repo/ai#evaluate:analysis-provenance --mode fixture --split all --seed 20260910",
    "evaluate:analysis-retrieval:fixture": "vp run @repo/ai#evaluate:analysis-retrieval --mode fixture --split all --seed 20260910",
    "evaluate:analysis-retrieval:replay": "vp run @repo/ai#evaluate:analysis-retrieval --mode replay --split all --seed 20260910",
    "prepare": "vp config",
    "test:focused-browser": "vp run web#test:focused-browser",
    "test:browser": "vp run web#test:browser",
    "benchmark:performance": "vp run @repo/ai#benchmark:performance"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.20.0"
}
