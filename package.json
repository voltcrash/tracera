{
  "name": "tracera",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=api --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "deploy:api": "pnpm --filter api run deploy",
    "deploy:web": "pnpm --filter web run deploy",
    "ios": "turbo run ios --filter=mobile",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.9"
  }
}
