{
  "name": "tracera",
  "private": true,
  "scripts": {
    "build": "node scripts/environment/run.mjs --profile local --role runtime -- vp run --filter web build",
    "check-types": "vp run -r check-types",
    "db:local:migrate": "node scripts/database/cli.mjs migrate --profile local",
    "db:local:reset": "node scripts/database/cli.mjs reset --profile local",
    "db:local:start": "node scripts/database/cli.mjs start --profile local",
    "db:local:status": "node scripts/database/cli.mjs status --profile local",
    "db:local:stop": "node scripts/database/cli.mjs stop --profile local",
    "db:rehearse": "node scripts/database/rehearse.mjs",
    "db:test:start": "node scripts/database/cli.mjs start --profile test",
    "db:test:status": "node scripts/database/cli.mjs status --profile test",
    "db:test:stop": "node scripts/database/cli.mjs stop --profile test",
    "dev": "node scripts/environment/run.mjs --profile local --role runtime --require-database -- vp run --filter web dev",
    "env:diagnose:local": "node scripts/environment/run.mjs --profile local --role runtime -- node scripts/environment/diagnose.mjs",
    "env:setup": "node scripts/environment/setup.mjs",
    "local:setup": "node scripts/local/workflow.mjs setup",
    "local:up": "node scripts/local/workflow.mjs up",
    "local:reset": "node scripts/local/workflow.mjs reset",
    "local:down": "node scripts/local/workflow.mjs down",
    "test:integration": "node scripts/local/workflow.mjs integration",
    "test:core-storage": "vp run @repo/db#test:core-storage",
    "test:auth-browser": "node scripts/auth/test-browser.mjs",
    "test:offline-analysis": "node scripts/analysis/test-offline.mjs",
    "evaluate:core:fixture": "node scripts/environment/run.mjs --profile test --role analysis -- vp run @repo/ai#evaluate:core --mode fixture --split all --seed 20260910",
    "prepare": "vp config"
  },
  "devDependencies": {
    "next": "16.3.4",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.20.0"
}
