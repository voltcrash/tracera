{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tracera-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "api.tracera.voltcrash.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "INTERNAL_API_URL": "https://api.tracera.voltcrash.com",
    "WEB_ORIGIN": "https://tracera.voltcrash.com",
    "PUBLIC_WEB_URL": "https://tracera.voltcrash.com"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
