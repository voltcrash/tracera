DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Cloudflare Workers use Upstash's HTTPS REST endpoint, not REDIS_URL/TCP.
# Leave these blank for local development if you do not need distributed limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Deployed web origin allowed to call the API Worker from a browser.
WEB_ORIGIN=https://tracera.voltcrash.com

# Better Auth runs only at https://tracera.voltcrash.com/api/auth/*.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Public API access. Configure one or more comma-separated secrets for key
# rotation. Data endpoints fail closed if keys or Upstash quotas are missing.
# PUBLIC_API_KEYS=replace-with-a-long-random-secret
PUBLIC_API_RATE_LIMIT_PER_MINUTE=30
PUBLIC_API_DAILY_QUOTA=1000

# Signed-in first-party analysis limits. Internal scheduled rechecks are
# bounded by their queue and do not consume these per-user quotas.
ANALYSIS_RATE_LIMIT_PER_MINUTE=5
ANALYSIS_DAILY_QUOTA=100

# AI provider configuration. Supported values: gemini, openai, openrouter,
# anthropic, and openai-compatible. Set the model and key for your provider.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Required for providers that expose embeddings. Must produce 1024 dimensions
# to match the pgvector schema.
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
# Optional endpoint override; required for AI_PROVIDER=openai-compatible.
# AI_BASE_URL=
#
# Anthropic has no embeddings API. Pair it with an embedding provider instead:
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_BASE_URL=

# Optional retrieval providers. Leave blank to rely on the claim corpus + GDELT.
# GOOGLE_FACT_CHECK_API_KEY=
# NEWS_API_KEY=
# WEB_SEARCH_ENDPOINT=
# WEB_SEARCH_API_KEY=

# Optional image provenance services. Without OCR_ENDPOINT, the selected
# generation model must support image input. A reverse-search service should
# return JSON shaped as { "searchUrl": "https://..." }.
# OCR_ENDPOINT=
# OCR_API_KEY=
# REVERSE_IMAGE_SEARCH_ENDPOINT=
# REVERSE_IMAGE_SEARCH_API_KEY=

# Retrieval tuning.
CORPUS_SIMILARITY_THRESHOLD=0.78
DEDUP_SIMILARITY_THRESHOLD=0.92
# Safety cap for the adaptive exact-submission reuse policy. Defaults range
# from 2h for breaking stories to 24h for established stories.
DEDUP_MAX_AGE_HOURS=24
# Reuse visually equivalent image submissions after clipboard/screenshot
# re-encoding. Keep this strict to avoid merging merely related images.
IMAGE_DEDUP_SIMILARITY_THRESHOLD=0.98
STORY_SIMILARITY_THRESHOLD=0.84
STORY_MAX_AGE_HOURS=2160

# Domain outcome signals are always audited. Automatic bounded updates remain
# off until the evaluation process approves them; editorial review uses a
# separate internal token.
DOMAIN_TRUST_AUTO_REFINE=false
DOMAIN_TRUST_ADMIN_TOKEN=replace-with-a-long-random-secret

# Required by the decay worker when it asks this API to bypass deduplication
# and create the next linked version of a check.
INTERNAL_WORKER_TOKEN=replace-with-a-long-random-secret
# Public URL of this deployed API Worker. Required by the hourly Cron Trigger.
INTERNAL_API_URL=https://api.tracera.voltcrash.com

# Optional delivery for material score changes made by the decay worker.
# If omitted, changes are still persisted in the Trace Timeline.
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=Tracera <alerts@example.com>
ALERT_SCORE_DELTA=5
PUBLIC_WEB_URL=https://tracera.voltcrash.com
