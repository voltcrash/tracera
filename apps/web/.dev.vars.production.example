# Copy to .dev.vars.production, chmod 600; never commit actual secrets.
# Generate once and preserve across deployments. Do not reuse staging or local secrets.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# OAuth homepage: https://tracera.voltcrash.com
# Callback: https://tracera.voltcrash.com/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-production-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-production-oauth-client-secret
# Google stays optional until Phase 4.4; configure both values or neither.
# Callback: https://tracera.voltcrash.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AI is optional (D18): leave every AI_ and ANALYSIS_MAX_ setting out to run with analysis
# unavailable, or configure the provider and every bound below together.
# AI_PROVIDER=replace-with-gemini-openai-anthropic-openrouter-or-openai-compatible
# AI_MODEL=replace-with-generation-model
# AI_API_KEY=replace-with-provider-api-key
# AI_EMBEDDING_MODEL=replace-with-embedding-model
# AI_BASE_URL=
# AI_EMBEDDING_PROVIDER=
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=
# GOOGLE_FACT_CHECK_API_KEY=
# NEWS_API_KEY=

# With a provider, explicit positive run/spend bounds are required. Prefer non-secret Wrangler vars.
# These file placeholders are accepted settings locations, not approved budgets.
# ANALYSIS_MAX_ELAPSED_MS must be <= 300000; targeted retrieval rounds may be zero.
# ANALYSIS_MAX_EXTERNAL_REQUESTS=replace-with-an-explicit-bound
# ANALYSIS_MAX_DISCOVERY_QUERIES_PER_CLAIM=replace-with-an-explicit-bound
# ANALYSIS_MAX_FETCHED_CANDIDATES_PER_CLAIM=replace-with-an-explicit-bound
# ANALYSIS_MAX_PROVENANCE_HOPS=replace-with-an-explicit-bound
# ANALYSIS_MAX_TARGETED_RETRIEVAL_ROUNDS=replace-with-an-explicit-bound
# ANALYSIS_MAX_ELAPSED_MS=replace-with-an-explicit-bound
# ANALYSIS_MAX_CONCURRENT_EXTERNAL_CALLS=replace-with-an-explicit-bound
# ANALYSIS_MAX_COST_USD=replace-with-an-explicit-bound
# AI_DAILY_SPEND_LIMIT_USD=replace-with-an-explicit-bound
# AI_ESTIMATED_GENERATION_COST_USD=replace-with-an-explicit-bound
# AI_ESTIMATED_IMAGE_COST_USD=replace-with-an-explicit-bound
# AI_ESTIMATED_EMBEDDING_COST_USD=replace-with-an-explicit-bound
