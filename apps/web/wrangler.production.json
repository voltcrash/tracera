{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracera",
  "main": "src/server.ts",
  "account_id": "eb2679ce4f23ae7db4e6c4e3fcf8c3c1",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tracera.voltcrash.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "MODE": "production",
    "ANALYSIS_MODE": "live",
    "BETTER_AUTH_URL": "https://tracera.voltcrash.com",
    "VERSION": "production"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracera-production",
      "database_id": "26eeb656-2c46-4182-ad48-4bd696684b01",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "tracera-production-blobs" }],
  "workflows": [
    {
      "binding": "ANALYSIS_WORKFLOW",
      "name": "tracera-production-analysis",
      "class_name": "AnalysisWorkflow"
    }
  ]
}
