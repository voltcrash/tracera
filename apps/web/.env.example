# Core settings required to run the web app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Supported: gemini, openai, openrouter, anthropic, openai-compatible.
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-provider-api-key

# Provider-specific overrides. The defaults are sufficient for Gemini.
# AI_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSIONS=1024
# AI_BASE_URL=                         # Required for openai-compatible.
# AI_EMBEDDING_PROVIDER=openai         # Required when using Anthropic.
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=

# Optional integrations and operational settings:
# docs/environment.md
