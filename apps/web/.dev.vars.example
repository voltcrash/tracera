# Copy to .dev.vars for local development. Local values only; never reuse them anywhere else.
MODE=dev
ANALYSIS_MODE=fixture
DEV_AUTH_BYPASS=true
BETTER_AUTH_SECRET=tracera-local-development-secret-only
VERSION=local
# Optional sign-in providers. Configure each pair completely or not at all.
# Callbacks: http://localhost:3000/api/auth/callback/github (or /google)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Live analysis with `vp run dev:live`, using your own provider key.
# AI_PROVIDER=gemini
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_PROVIDER=
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=
# Personal key storage: generate a private encryption keyring with
# vp run web#provider-keys:generate-secret /PRIVATE_DIR/local-byok.env
# Add that file's PROVIDER_KEYS_ENCRYPTION_KEY line here; preserve it across restarts.
# Optional evidence sources.
# GOOGLE_FACT_CHECK_API_KEY=
# NEWS_API_KEY=

# Live mode requires explicit run and spend bounds. Choose these before enabling a provider.
# ANALYSIS_MAX_ELAPSED_MS must be <= 300000; targeted retrieval rounds may be zero.
# ANALYSIS_MAX_EXTERNAL_REQUESTS=
# ANALYSIS_MAX_DISCOVERY_QUERIES_PER_CLAIM=
# ANALYSIS_MAX_FETCHED_CANDIDATES_PER_CLAIM=
# ANALYSIS_MAX_PROVENANCE_HOPS=
# ANALYSIS_MAX_TARGETED_RETRIEVAL_ROUNDS=
# ANALYSIS_MAX_ELAPSED_MS=
# ANALYSIS_MAX_CONCURRENT_EXTERNAL_CALLS=
# ANALYSIS_MAX_COST_USD=
# AI_DAILY_SPEND_LIMIT_USD=
# AI_ESTIMATED_GENERATION_COST_USD=
# AI_ESTIMATED_IMAGE_COST_USD=
# AI_ESTIMATED_EMBEDDING_COST_USD=
