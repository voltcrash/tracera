{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:live": "vp dev --mode live",
    "build": "vp build",
    "check-types": "tsc --noEmit",
    "provider-keys:generate-secret": "node scripts/create-provider-key-secret.mjs",
    "test:auth-browser": "playwright test local-auth.e2e.ts",
    "test:focused-browser": "playwright test focused-acceptance.e2e.ts",
    "cf-typegen": "wrangler types --env-file .dev.vars.example && vp fmt worker-configuration.d.ts",
    "preview": "vp preview",
    "db:migrate": "wrangler d1 migrations apply tracera-staging --local",
    "db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state/v3/d1', { recursive: true, force: true })\" && vp run db:migrate",
    "build:production": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.production.json vp build",
    "db:migrate:staging": "wrangler d1 migrations apply tracera-staging --remote",
    "deploy:staging": "vp run db:migrate:staging && vp run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:staging-dry-run": "vp run build && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "check:production": "vp run build:production && tsx scripts/check-production.ts",
    "deploy:production-dry-run": "vp run check:production && wrangler deploy --config dist/server/wrangler.json --secrets-file .dev.vars.production --dry-run",
    "db:migrate:production": "wrangler d1 migrations apply tracera-production --remote --config wrangler.production.json",
    "deploy:production": "vp run check:production && wrangler deploy --config dist/server/wrangler.json --secrets-file .dev.vars.production",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@repo/ai": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@playwright/test": "^1.64.0",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "wrangler": "^4.150.0"
  }
}
