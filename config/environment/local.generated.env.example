# Illustrative only. Run `vp run env:setup`; do not copy this file.
# Generated values live in ignored, mode-0600 files under .tracera/environment/.

# local/shared.env
TRACERA_WORKTREE_ID=worktree_name_hash
TRACERA_DATABASE_HOST=127.0.0.1
TRACERA_DATABASE_PORT=WORKTREE_PORT
TRACERA_DATABASE_NAME=tracera_worktree_name_hash_dev

# local/runtime.env
DATABASE_URL=postgresql://tracera_runtime:GENERATED_PASSWORD@127.0.0.1:WORKTREE_PORT/tracera_worktree_name_hash_dev
BETTER_AUTH_SECRET=GENERATED_SECRET

# local/migration.env
DATABASE_MIGRATOR_URL=postgresql://tracera_migrator:GENERATED_PASSWORD@127.0.0.1:WORKTREE_PORT/tracera_worktree_name_hash_dev

# test/shared.env (the test cluster listens on the local port + 1)
TRACERA_WORKTREE_ID=worktree_name_hash
TRACERA_DATABASE_HOST=127.0.0.1
TRACERA_DATABASE_PORT=WORKTREE_TEST_PORT
TRACERA_DATABASE_NAME=tracera_worktree_name_hash_test

# test/test-provisioning.env
TEST_DATABASE_PROVISIONER_URL=postgresql://tracera_test_provisioner:GENERATED_PASSWORD@127.0.0.1:WORKTREE_TEST_PORT/postgres
