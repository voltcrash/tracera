# Runtime connection. Use the tracera_runtime role created by the migrations.
DATABASE_URL=postgresql://tracera_runtime:PASSWORD@HOST/DATABASE?sslmode=require

# Owner connection. Use only for migrations; never deploy this URL to the web app.
DATABASE_MIGRATOR_URL=postgresql://OWNER:PASSWORD@HOST/DATABASE?sslmode=require

# Core settings required to run Tracera.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_CLIENT_ID=replace-with-github-app-client-id
GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret

# Development only: enable GET /api/auth/dev-login on a loopback host.
# DEV_AUTH_BYPASS=true

# Supported: gemini, openai, openrouter, anthropic, openai-compatible.
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-provider-api-key

# Add only the overrides required by the selected provider.
# AI_MODEL=
# AI_EMBEDDING_MODEL=
# AI_BASE_URL=                         # Required for openai-compatible.
# AI_EMBEDDING_PROVIDER=openai         # Required when using Anthropic.
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=

# Optional evidence retrieval providers.
# GOOGLE_FACT_CHECK_API_KEY=
# NEWS_API_KEY=

# Distributed analysis safeguards. Defaults are safe for a small deployment;
# each value can be raised for a trusted, higher-volume installation.
# ANALYSIS_USER_RATE_LIMIT=30
# ANALYSIS_IP_RATE_LIMIT=60
# ANALYSIS_RATE_WINDOW_SECONDS=3600
# ANALYSIS_USER_CONCURRENCY_LIMIT=2
# ANALYSIS_IP_CONCURRENCY_LIMIT=4
# ANALYSIS_DAILY_QUOTA=100
# ANALYSIS_FORCE_REANALYSIS_COOLDOWN_SECONDS=3600
# ANALYSIS_LEASE_SECONDS=600
# ANALYSIS_IDEMPOTENCY_TTL_SECONDS=86400
# AI_DAILY_SPEND_LIMIT_USD=25
# AI_ESTIMATED_GENERATION_COST_USD=0.01
# AI_ESTIMATED_IMAGE_COST_USD=0.02
# AI_ESTIMATED_EMBEDDING_COST_USD=0.0001

# Optional administration settings.
# DOMAIN_TRUST_AUTO_REFINE=
# DOMAIN_TRUST_ADMIN_TOKEN=
