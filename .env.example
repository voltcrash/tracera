# Core settings required to run Tracera.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_API_KEY=replace-with-api-key
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_CLIENT_ID=replace-with-github-app-client-id
GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret

# Development only: enable GET /api/auth/dev-login on a loopback host.
# DEV_AUTH_BYPASS=true

# Supported: gemini, openai, openrouter, anthropic, openai-compatible.
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-provider-api-key

# Add only the overrides required by the selected provider.
# AI_MODEL=
# AI_EMBEDDING_MODEL=
# AI_BASE_URL=                         # Required for openai-compatible.
# AI_EMBEDDING_PROVIDER=openai         # Required when using Anthropic.
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=

# Optional evidence retrieval providers.
# GOOGLE_FACT_CHECK_API_KEY=
# NEWS_API_KEY=

# Optional administration settings.
# BETTER_AUTH_API_KEY=
# DOMAIN_TRUST_AUTO_REFINE=
# DOMAIN_TRUST_ADMIN_TOKEN=
